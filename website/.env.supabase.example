# Server environment only. Never include the secret key in browser/app configuration.
REPORTING_STORAGE=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_SECRET
